# Copy to .env.local for development. Do NOT commit real secrets.
#
# This site's contact form posts same-origin to /api/contact, which then
# forwards server-side to ${NEXT_PUBLIC_PARENT_API_URL}/api/webhooks/forms
# on the raymond-gray-platform backend, authenticated with WEBHOOK_SECRET.

# Public origin of THIS site. Used to derive the sourceDomain reported to
# the parent webhook. Local dev: http://localhost:3001
NEXT_PUBLIC_APP_URL="https://remotesupport.raymond-gray.org"

# Parent platform that ingests the form.
#   Local (local parent):  http://localhost:3000
#   Local (live parent):   https://www.raymond-gray.org
#   Production:            https://www.raymond-gray.org
NEXT_PUBLIC_PARENT_API_URL="https://www.raymond-gray.org"

# Upstash Redis — powers rate limiting (3 req/min/IP).
# If unset locally, rate limiting is skipped and the form still works.
# REQUIRED in production hosting env.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Shared secret — MUST equal WEBHOOK_SECRET on raymond-gray-platform.
# REQUIRED in production hosting env (without it the proxy returns 500).
WEBHOOK_SECRET=""
